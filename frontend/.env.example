# ============================================================
# OA_PER Frontend 环境变量配置模板
# ============================================================

# ---------- 开发服务器配置 ----------
# 开发服务器监听的主机名（如需局域网访问设为 0.0.0.0）
# VITE_DEV_HOST=localhost

# 后端代理目标地址（开发环境）
# VITE_PROXY_TARGET=https://localhost:8097

# ---------- SSL 证书（开发环境 HTTPS）----------
# 开发环境使用 mkcert 生成的本地证书，放在 frontend/ssl/ 目录下
# 生成方式: mkcert localhost 127.0.0.1 ::1
# SSL_ENABLED=true
# SSL_CERT_PATH=./ssl/localhost+2.pem
# SSL_KEY_PATH=./ssl/localhost+2-key.pem

# ---------- API 配置 ----------
# 开发环境 API 地址（.env.development 中已配置）
# VITE_API_BASE=https://localhost:8097/api

# 生产环境 API 地址（.env.production 中已配置）
# VITE_API_BASE=/api