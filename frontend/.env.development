# 开发环境
# 后端 API 地址
VITE_API_BASE=/api

# 后端代理目标地址（vite.config.js proxy 使用）
VITE_PROXY_TARGET=https://localhost:8097

# 开发服务器主机（默认 localhost，如需局域网访问设为 0.0.0.0）
VITE_DEV_HOST=localhost

# SSL 证书开关（设为 false 可禁用 HTTPS 开发服务器）
SSL_ENABLED=true
SSL_CERT_PATH=./ssl/localhost+2.pem
SSL_KEY_PATH=./ssl/localhost+2-key.pem