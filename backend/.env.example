# ============================================================
# OA_PER Backend 环境变量配置模板
# ============================================================
# 使用方式（三选一）：
#   1. IntelliJ IDEA: 安装 EnvFile 插件，在 Run Configuration 中勾选 .env 文件
#   2. 命令行: source .env && mvn spring-boot:run
#   3. 在 IDE 的 Run Configuration > Environment Variables 中逐条填入
# ============================================================

# ---------- 数据库 ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=oa_per
MYSQL_USER=root
MYSQL_PASSWORD=1234

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_DB=12

# ---------- 邮件服务 (163邮箱) ----------
# 密码为邮箱授权码，非登录密码。在 163 邮箱设置中开启 SMTP 获取
MAIL_USERNAME=13387493272@163.com
MAIL_PASSWORD=FApFnhriutyYzj2h

# ---------- MinIO 对象存储 ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oa-per
MINIO_URL_PREFIX=/minio

# ---------- JWT ----------
JWT_SECRET=Ua0Px88+Id9qLL2VS9L3VDRkuN9FDDzQNlgGMmzn18gFYZOIzferzB8V/rIhaxbi

# ---------- SSL 证书（开发环境 HTTPS）----------
# 开发环境使用 mkcert 生成的本地证书，放在 src/main/resources/ssl/ 目录下
# 证书文件已被 .gitignore 忽略，需自行生成
# 生成方式: mkcert localhost 127.0.0.1 ::1
SSL_ENABLED=true
SSL_CERT_PATH=classpath:ssl/localhost+2.pem
SSL_KEY_PATH=classpath:ssl/localhost+2-key.pem

